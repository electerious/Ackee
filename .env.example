# ==============================================
# ACKEE CONFIGURATION FOR COOLIFY DEPLOYMENT
# ==============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the required values (marked with [REQUIRED])
# 3. Coolify will auto-detect these variables in UI
# 4. Never commit .env to git!
#
# ==============================================

# -----------------------
# DATABASE CONFIGURATION
# -----------------------
# MongoDB Connection String [REQUIRED]
# Format: mongodb://username:password@host:port/database
# For Coolify: Use service name 'mongo' as host
ACKEE_MONGODB=mongodb://mongo:27017/ackee

# MongoDB Root Credentials [REQUIRED]
# Coolify will generate these if left empty in UI
MONGO_USERNAME=root
MONGO_PASSWORD=

# -----------------------
# AUTHENTICATION
# -----------------------
# Admin Dashboard Credentials [REQUIRED]
# Use strong passwords (min 16 characters)
ACKEE_USERNAME=admin
ACKEE_PASSWORD=

# Session Token TTL (milliseconds) [OPTIONAL]
# Default: 3600000 (1 hour)
ACKEE_TTL=3600000

# -----------------------
# CORS & SECURITY
# -----------------------
# Allowed origins for CORS [OPTIONAL]
# Use * for all origins (development only!)
# Production: comma-separated domains (https://example.com,https://app.example.com)
ACKEE_ALLOW_ORIGIN=*

# Auto-add CORS headers for request origins [OPTIONAL]
# Set to false in production for better security
ACKEE_AUTO_ORIGIN=true

# -----------------------
# APPLICATION
# -----------------------
# Node Environment [OPTIONAL]
# Values: production, development
NODE_ENV=production

# Internal Application Port [DO NOT CHANGE]
# Ackee listens on port 3000 inside container
# External access via port 3003 (configured in docker-compose.yml)
ACKEE_PORT=3000

# Custom tracker script name [OPTIONAL]
# Rename to avoid ad blockers (e.g., analytics.js, stats.js, data.js)
# Default: tracker.js
ACKEE_TRACKER=tracker.js

# -----------------------
# COOLIFY MAGIC VARIABLES
# -----------------------
# These are auto-generated by Coolify platform
# Do NOT set these manually - Coolify injects them at runtime

# SERVICE_URL_ACKEE_3003=https://your-domain.com:3003
# SERVICE_FQDN_ACKEE=your-domain.com
# SERVICE_PASSWORD_MONGO=<auto-generated-password>
# SERVICE_USER_MONGO=<auto-generated-username>

# -----------------------
# ADVANCED CONFIGURATION
# -----------------------

# Demo Mode [OPTIONAL]
# Enables demo mode with pre-populated data
# ACKEE_DEMO=false

# Build Environment [OPTIONAL]
# Used during build process
# BUILD_ENV=production
